  "components": {
    "schemas": {
      "AskRequest": {
        "properties": {
          "query": {
            "type": "string",
            "maxLength": 2000,
            "minLength": 3,
            "title": "Query",
            "description": "Pergunta sobre os documentos"
          },
          "n_results": {
            "type": "integer",
            "maximum": 20.0,
            "minimum": 1.0,
            "title": "N Results",
            "description": "Número de chunks a recuperar",
            "default": 5
          },
          "source_filter": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Source Filter",
            "description": "Filtrar por nome do arquivo PDF"
          },
          "doc_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Doc Id",
            "description": "Filtrar por id único do documento"
          },
          "origem": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Origem",
            "description": "Filtrar por origem (ex.: upload, livro)"
          },
          "grupo": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Grupo",
            "description": "Filtrar por grupo"
          },
          "nivel_acesso": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "publico",
                  "interno",
                  "sigiloso"
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "Nivel Acesso",
            "description": "Filtrar por nível de acesso"
          },
          "data_inicio": {
            "anyOf": [
              {
                "type": "string",
                "format": "date"
              },
              {
                "type": "null"
              }
            ],
            "title": "Data Inicio",
            "description": "Data do documento a partir de (inclusive)"
          },
          "data_fim": {
            "anyOf": [
              {
                "type": "string",
                "format": "date"
              },
              {
                "type": "null"
              }
            ],
            "title": "Data Fim",
            "description": "Data do documento até (inclusive)"
          }
        },
        "type": "object",
        "required": [
          "query"
        ],
        "title": "AskRequest",
        "description": "Subclass of QueryRequest so `/search` and `/search/ask` share a single\nsource of field definitions (they cannot drift apart) while keeping a\ndistinct schema name in the OpenAPI document."
      },
      "AskResponse": {
        "properties": {
          "query": {
            "type": "string",
            "title": "Query"
          },
          "answer": {
            "type": "string",
            "title": "Answer"
          },
          "sources": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Sources"
          },
          "source_links": {
            "items": {
              "$ref": "#/components/schemas/SourceLink"
            },
            "type": "array",
            "title": "Source Links"
          },
          "chunks_used": {
            "type": "integer",
            "title": "Chunks Used"
          },
          "model": {
            "type": "string",
            "title": "Model"
          }
        },
        "type": "object",
        "required": [
          "query",
          "answer",
          "sources",
          "chunks_used",
          "model"
        ],
        "title": "AskResponse"
      },
      "AuditLogOut": {
        "properties": {
          "id": {
            "type": "integer",
            "title": "Id"
          },
          "user_id": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "User Id"
          },
          "email": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Email"
          },
          "via_api_key": {
            "type": "boolean",
            "title": "Via Api Key"
          },
          "query": {
            "type": "string",
            "title": "Query"
          },
          "sources": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Sources"
          },
          "chunks_used": {
            "type": "integer",
            "title": "Chunks Used"
          },
          "status": {
            "type": "string",
            "title": "Status"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          }
        },
        "type": "object",
        "required": [
          "id",
          "via_api_key",
          "query",
          "sources",
          "chunks_used",
          "status",
          "created_at"
        ],
        "title": "AuditLogOut"
      },
      "Body_upload_document_documents_upload_post": {
        "properties": {
          "file": {
            "type": "string",
            "contentMediaType": "application/octet-stream",
            "title": "File",
            "description": "PDF file to upload and index"
          }
        },
        "type": "object",
        "required": [
          "file"
        ],
        "title": "Body_upload_document_documents_upload_post"
      },
      "ChunkResult": {
        "properties": {
          "text": {
            "type": "string",
            "title": "Text"
          },
          "metadata": {
            "$ref": "#/components/schemas/DocumentMetadata"
          },
          "distance": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Distance"
          }
        },
        "type": "object",
        "required": [
          "text",
          "metadata"
