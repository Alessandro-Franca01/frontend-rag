    "/users/{user_id}": {
      "patch": {
        "tags": [
          "Users"
        ],
        "summary": "Activate/deactivate a user or change their role",
        "operationId": "update_user_users__user_id__patch",
        "security": [
          {
            "HTTPBearer": []
          },
          {
            "APIKeyHeader": []
          }
        ],
        "parameters": [
          {
            "name": "user_id",
            "in": "path",
