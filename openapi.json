          }
        },
        "security": [
          {
            "HTTPBearer": []
          },
          {
            "APIKeyHeader": []
          }
        ]
      }
    },
    "/documents/": {
      "get": {
        "tags": [
          "Documents"
        ],
        "summary": "List all indexed documents and collection stats",
        "operationId": "list_documents_documents__get",
        "security": [
          {
            "HTTPBearer": []
          },
          {
            "APIKeyHeader": []
          }
        ],
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 1000,
              "minimum": 1,
              "description": "Documents per page",
              "default": 100,
              "title": "Limit"
            },
            "description": "Documents per page"
          },
          {
            "name": "offset",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 0,
              "description": "Documents to skip",
              "default": 0,
              "title": "Offset"
            },
            "description": "Documents to skip"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CollectionStatsResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      },
      "delete": {
        "tags": [
          "Documents"
        ],
        "summary": "Clear the entire collection (all documents)",
        "operationId": "clear_collection_documents__delete",
        "security": [
          {
            "HTTPBearer": []
          },
          {
            "APIKeyHeader": []
          }
        ],
        "responses": {
          "204": {
            "description": "Successful Response"
          }
        }
      }
    },
    "/documents/ingest": {
      "post": {
        "tags": [
          "Documents"
        ],
        "summary": "Index a PDF that is already in the storage (called by the Livro system)",
        "description": "Downloads the PDF at `key`, extracts its text and indexes it with the report\nmetadata. Idempotent per (`origem`, `external_id`): sending the same report\nagain replaces the previous version, and an identical file is not re-indexed.",
        "operationId": "ingest_document_documents_ingest_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/IngestRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/IngestResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        },
        "security": [
          {
            "APIKeyHeader": []
          }
        ]
      }
    },
    "/documents/upload": {
      "post": {
        "tags": [
          "Documents"
        ],
        "summary": "Upload and index a PDF document",
        "description": "Upload a PDF file, extract its text, split into overlapping chunks,\ngenerate embeddings and persist them in ChromaDB.",
        "operationId": "upload_document_documents_upload_post",
        "security": [
          {
            "HTTPBearer": []
          },
          {
            "APIKeyHeader": []
          }
        ],
        "parameters": [
          {
            "name": "chunk_size",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 2000,
              "minimum": 20,
              "description": "Words per chunk",
              "default": 500,
              "title": "Chunk Size"
            },
            "description": "Words per chunk"
          },
          {
            "name": "overlap",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 500,
              "minimum": 0,
              "description": "Overlap between chunks",
              "default": 100,
              "title": "Overlap"
            },
            "description": "Overlap between chunks"
          },
          {
            "name": "grupo",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "maxLength": 100,
              "description": "Group the document belongs to",
              "default": "",
              "title": "Grupo"
            },
            "description": "Group the document belongs to"
          },
          {
            "name": "nivel_acesso",
            "in": "query",
            "required": false,
            "schema": {
              "enum": [
                "publico",
                "interno",
                "sigiloso"
              ],
              "type": "string",
              "description": "Access level of the document",
              "default": "interno",
              "title": "Nivel Acesso"
            },
            "description": "Access level of the document"
          },
          {
            "name": "data",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                  "format": "date"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Document date (defaults to today)",
              "title": "Data"
            },
            "description": "Document date (defaults to today)"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/Body_upload_document_documents_upload_post"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProcessDocumentResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/documents/{pdf_name}": {
      "delete": {
        "tags": [
          "Documents"
        ],
        "summary": "Remove a document by doc_id (or every document uploaded under a file name)",
        "operationId": "delete_document_documents__pdf_name__delete",
        "security": [
          {
            "HTTPBearer": []
          },
          {
            "APIKeyHeader": []
          }
